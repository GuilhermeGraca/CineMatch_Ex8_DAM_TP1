<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#640505</color>
    <color name="md_theme_background">#100505</color>
    <color name="md_theme_error">#FFB4AB</color>
    <color name="md_theme_onBackground">#f8f5f6</color>
    <color name="md_theme_onError">#690005</color>
    <color name="md_theme_onPrimary">#FFFFFF</color>
    <color name="md_theme_onPrimaryContainer">#3D0001</color>
    <color name="md_theme_onSecondary">#FFFFFF</color>
    <color name="md_theme_onSecondaryContainer">#1D192B</color>
    <color name="md_theme_onSurface">#f8f5f6</color>
    <color name="md_theme_primary">#e60a11</color>
    <color name="md_theme_primaryContainer">#FFF0F1</color>
    <color name="md_theme_secondary">#8C819C</color>
    <color name="md_theme_secondaryContainer">#E8DEF8</color>
    <color name="md_theme_surface">#1A0C0C</color>
    <string name="app_name">CineMatch</string>
    <style name="CustomChipStyle" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_color</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
    </style>
    <style name="Theme.CineMatch" parent="Theme.Material3.Dark.NoActionBar">
        
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
        
        <item name="android:statusBarColor">#000000</item>
        
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        
        <item name="android:windowBackground">@drawable/bg_cinema_gradient</item>
        
        
        <item name="chipStyle">@style/CustomChipStyle</item>
    </style>
</resources>