<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.cinematch.ui.main.MainFragment"
        android:label="CineMatch"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/action_mainFragment_to_resultsFragment"
            app:destination="@id/resultsFragment" />
        <action
            android:id="@+id/action_mainFragment_to_watchlistFragment"
            app:destination="@id/watchlistFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/resultsFragment"
        android:name="com.example.cinematch.ui.results.ResultsFragment"
        android:label="Recommendations"
        tools:layout="@layout/fragment_results">
        <argument
            android:name="genre"
            app:argType="string" />
        <action
            android:id="@+id/action_resultsFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.cinematch.ui.details.DetailsFragment"
        android:label="Movie Details"
        tools:layout="@layout/fragment_details">
        <argument
            android:name="imdbId"
            app:argType="string" />
    </fragment>
    
    <fragment
        android:id="@+id/watchlistFragment"
        android:name="com.example.cinematch.ui.watchlist.WatchlistFragment"
        android:label="My Watchlist"
        tools:layout="@layout/fragment_watchlist">
        <action
            android:id="@+id/action_watchlistFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>
</navigation>
